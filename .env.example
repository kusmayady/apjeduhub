# Gemini API Key for server-side AI endpoints (/api/chat, /api/generate-article, /api/edufin-advisor)
GEMINI_API_KEY=

# Server Port (defaults to 3000)
PORT=3000

# Database Provider: leave unset/firebase for Cloud Firestore, or set to 'mariadb' for local MacPorts MariaDB
DB_PROVIDER=

# Local MariaDB Configuration (MacPorts macOS defaults)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_SOCKET=/opt/local/var/run/mariadb-10.11/mysqld.sock
MARIADB_USER=apj_user
MARIADB_PASSWORD=
MARIADB_DATABASE=apjeduhub

# Optional Local Admin Credentials for MariaDB mode (if ADMIN_PASSCODE is empty, first-run setup is used)
ADMIN_EMAIL=admin@apj.ac.id
ADMIN_PASSCODE=
